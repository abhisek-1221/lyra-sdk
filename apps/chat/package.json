    "@lyra-sdk/generation": "0.1.0",
    "@lyra-sdk/index": "0.1.0",
    "@lyra-sdk/ingestion": "0.1.0",
    "@lyra-sdk/kernel": "0.1.0",
    "@lyra-sdk/pipeline": "0.1.0",
    "@lyra-sdk/prompt": "0.1.0",
    "@lyra-sdk/reranking": "0.1.0",
    "@lyra-sdk/retrieval": "0.1.0",
    "@lyra-sdk/storage": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
